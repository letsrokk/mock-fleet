{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mock-fleet values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespaceOverride": { "type": "string" },
    "fleet": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "podInactivityThreshold": { "type": "string" },
        "podCreationTimeout": { "type": "string" },
        "routing": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["HOST", "PATH"] }
          },
          "required": ["mode"]
        },
        "service": { "$ref": "#/definitions/fleetService" },
        "resources": { "$ref": "#/definitions/containerResources" }
      },
      "required": ["image", "replicas", "podInactivityThreshold", "podCreationTimeout", "routing", "service", "resources"]
    },
    "dash": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "service": { "$ref": "#/definitions/dashService" },
        "resources": { "$ref": "#/definitions/containerResources" }
      },
      "required": ["enabled", "image", "replicas", "service", "resources"]
    },
    "wiremock": { "type": "object" },
    "ingress": { "type": "object" },
    "securityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "type": "boolean" }
      },
      "required": ["runAsNonRoot"]
    },
    "storage": { "type": "object" },
    "probes": { "type": "object" },
    "env": { "type": "object" },
    "serviceAccount": { "type": "object" },
    "rbac": { "type": "object" },
    "hazelcast": { "type": "object" }
  },
  "required": [
    "fleet",
    "dash",
    "wiremock",
    "ingress",
    "securityContext",
    "storage",
    "probes",
    "env",
    "serviceAccount",
    "rbac",
    "hazelcast"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "fleetService": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "ports": {
          "type": "object",
          "properties": {
            "http": { "type": "integer" },
            "targetHttp": { "type": "integer" },
            "debug": { "type": "integer" },
            "targetDebug": { "type": "integer" }
          },
          "required": ["http", "targetHttp", "debug", "targetDebug"]
        }
      },
      "required": ["type", "ports"]
    },
    "dashService": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "ports": {
          "type": "object",
          "properties": {
            "http": { "type": "integer" },
            "targetHttp": { "type": "integer" }
          },
          "required": ["http", "targetHttp"]
        }
      },
      "required": ["type", "ports"]
    },
    "containerResources": {
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/definitions/resourceValues" },
        "limits": { "$ref": "#/definitions/resourceValues" }
      },
      "required": ["requests", "limits"]
    },
    "resourceValues": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [{ "type": "string" }, { "type": "number" }]
      }
    }
  }
}

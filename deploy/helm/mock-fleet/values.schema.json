{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mock-fleet values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespaceOverride": { "type": "string" },
    "clusterDomain": { "type": "string", "minLength": 1 },
    "fleet": {
      "type": "object",
      "properties": {
        "proxy": { "$ref": "#/definitions/app" },
        "api": {
          "allOf": [
            { "$ref": "#/definitions/app" },
            {
              "type": "object",
              "properties": {
                "replicas": { "type": "integer", "minimum": 2 },
                "podInactivityThreshold": { "type": "string" },
                "podCreationTimeout": { "type": "string" },
                "maxActiveMocks": { "type": "integer", "minimum": 1 },
                "maxConcurrentStarts": { "type": "integer", "minimum": 1 },
                "queuedStartCapacity": { "type": "integer", "minimum": 1 },
                "mappings": {
                  "type": "object",
                  "properties": {
                    "maxDepth": { "type": "integer", "minimum": 1 },
                    "maxEntries": { "type": "integer", "minimum": 1 }
                  },
                  "required": ["maxDepth", "maxEntries"]
                },
                "networkPolicy": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" }
                  },
                  "required": ["enabled"]
                },
                "service": {
                  "type": "object",
                  "properties": {
                    "ports": {
                      "type": "object",
                      "properties": {
                        "targetHttp": { "type": "integer", "const": 8080 }
                      },
                      "required": ["targetHttp"]
                    }
                  },
                  "required": ["ports"]
                },
                "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
                "updateStrategy": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
                    "rollingUpdate": {
                      "type": "object",
                      "properties": {
                        "maxUnavailable": { "type": ["integer", "string"] },
                        "maxSurge": { "type": ["integer", "string"] }
                      },
                      "required": ["maxUnavailable", "maxSurge"]
                    }
                  },
                  "required": ["type", "rollingUpdate"]
                },
                "pdb": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "minAvailable": { "type": ["integer", "string"] }
                  },
                  "required": ["enabled", "minAvailable"]
                }
              },
              "required": [
                "podInactivityThreshold",
                "podCreationTimeout",
                "maxActiveMocks",
                "maxConcurrentStarts",
                "queuedStartCapacity",
                "mappings",
                "networkPolicy",
                "terminationGracePeriodSeconds",
                "updateStrategy",
                "pdb"
              ]
            }
          ]
        },
        "dash": {
          "allOf": [
            { "$ref": "#/definitions/app" },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              },
              "required": ["enabled"]
            }
          ]
        },
        "mcp": {
          "allOf": [
            { "$ref": "#/definitions/app" },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "replicas": { "type": "integer", "const": 1 },
                "apiBaseUrl": { "type": "string" },
                "proxyBaseUrl": { "type": "string" },
                "routing": {
                  "type": "object",
                  "properties": {
                    "mode": { "type": "string", "enum": ["", "PATH", "HOST"] },
                    "fleetHost": { "type": "string" }
                  },
                  "required": ["mode", "fleetHost"]
                },
                "allowedOrigins": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "outbound": {
                  "type": "object",
                  "properties": {
                    "exceptions": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "allowedListeners": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "networkPolicy": {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "dnsNamespace": { "type": "string", "minLength": 1 },
                        "dnsPodSelector": {
                          "type": "object",
                          "additionalProperties": { "type": "string" },
                          "minProperties": 1
                        },
                        "allowedCidrs": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        }
                      },
                      "required": ["enabled", "dnsNamespace", "dnsPodSelector", "allowedCidrs"]
                    }
                  },
                  "required": ["exceptions", "allowedListeners", "networkPolicy"]
                },
                "sensitiveHeaders": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "timeout": { "type": "string", "minLength": 1 },
                "lifecycleTimeout": { "type": "string", "minLength": 1 },
                "defaultPageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
                "maxPageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
                "maxPayloadBytes": { "type": "integer", "minimum": 1 },
                "includedBodyBytes": { "type": "integer", "minimum": 1 },
                "dependencyHealthTimeout": { "type": "string", "minLength": 1 },
                "maxCollectionScanBytes": { "type": "integer", "minimum": 1 },
                "maxCollectionScanItems": { "type": "integer", "minimum": 1 }
              },
              "required": [
                "enabled",
                "apiBaseUrl",
                "proxyBaseUrl",
                "routing",
                "allowedOrigins",
                "outbound",
                "sensitiveHeaders",
                "timeout",
                "lifecycleTimeout",
                "defaultPageSize",
                "maxPageSize",
                "maxPayloadBytes",
                "includedBodyBytes",
                "dependencyHealthTimeout",
                "maxCollectionScanBytes",
                "maxCollectionScanItems"
              ]
            }
          ]
        }
      },
      "required": ["proxy", "api", "dash", "mcp"]
    },
    "ingress": { "type": "object" },
    "storage": { "type": "object" },
    "wiremock": {
      "type": "object",
      "properties": {
        "podNamePrefix": { "type": "string", "minLength": 1 },
        "containerName": { "type": "string", "minLength": 1 },
        "containerImage": { "type": "string", "minLength": 1 },
        "supportedImageTags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^3\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9]+)?$"
          }
        },
        "containerImagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": { "type": "object" }
          },
          "required": ["create", "name", "annotations"]
        },
        "admissionPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "workloadIdentity": {
              "type": "object",
              "properties": {
                "allowedTokenAudiences": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9.:/_-]*$"
                  }
                }
              },
              "required": ["allowedTokenAudiences"]
            }
          },
          "required": ["enabled", "workloadIdentity"]
        },
        "resourcePolicy": {
          "type": "object",
          "properties": {
            "requestFloor": { "$ref": "#/definitions/resourcePair" },
            "limitCeiling": { "$ref": "#/definitions/resourcePair" }
          },
          "required": ["requestFloor", "limitCeiling"]
        },
        "config": {
          "type": "object",
          "properties": {
            "default": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "options": { "type": "array", "items": { "type": "string" } },
                "resources": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requests": { "$ref": "#/definitions/resourcePair" },
                    "limits": { "$ref": "#/definitions/resourcePair" }
                  },
                  "required": ["requests", "limits"]
                }
              },
              "required": ["options", "resources"]
            },
            "mocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "version": {
                    "type": ["string", "null"],
                    "pattern": "^3\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                  },
                  "options": { "type": "array", "items": { "type": "string" } },
                  "resources": {
                    "type": ["object", "null"],
                    "additionalProperties": false,
                    "properties": {
                      "requests": { "$ref": "#/definitions/partialResourcePair" },
                      "limits": { "$ref": "#/definitions/partialResourcePair" }
                    }
                  }
                },
                "required": ["id"]
              }
            }
          },
          "required": ["default", "mocks"]
        }
      },
      "required": [
        "podNamePrefix",
        "containerName",
        "containerImage",
        "supportedImageTags",
        "containerImagePullPolicy",
        "terminationGracePeriodSeconds",
        "serviceAccount",
        "admissionPolicy",
        "resourcePolicy",
        "config"
      ]
    },
    "securityContext": { "type": "object" },
    "env": { "type": "object" },
    "serviceAccount": { "type": "object" },
    "rbac": { "type": "object" },
    "resourceQuota": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "hard": {
          "type": "object",
          "properties": {
            "pods": { "type": "integer", "minimum": 1 },
            "requests.cpu": { "$ref": "#/definitions/resourceQuantity" },
            "requests.memory": { "$ref": "#/definitions/resourceQuantity" },
            "limits.cpu": { "$ref": "#/definitions/resourceQuantity" },
            "limits.memory": { "$ref": "#/definitions/resourceQuantity" }
          },
          "required": ["pods", "requests.cpu", "requests.memory", "limits.cpu", "limits.memory"]
        }
      },
      "required": ["enabled", "hard"]
    },
    "hazelcast": {
      "type": "object",
      "properties": {
        "clusterName": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "backupCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "gracefulShutdownMaxWaitSeconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["clusterName", "port", "backupCount", "gracefulShutdownMaxWaitSeconds"]
    }
  },
  "required": ["clusterDomain", "fleet", "ingress", "storage", "wiremock", "securityContext", "env", "serviceAccount", "rbac", "resourceQuota", "hazelcast"],
  "allOf": [
    {
      "if": {
        "properties": {
          "fleet": {
            "properties": {
              "mcp": {
                "properties": {
                  "enabled": { "const": true }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "wiremock": {
            "properties": {
              "containerImage": {
                "pattern": "^.+:3\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9.-]*)?(@sha256:[a-fA-F0-9]{64})?$"
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "app": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "dev": { "$ref": "#/definitions/dev" },
        "routing": { "type": "object" },
        "logging": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean" },
            "level": { "type": "string", "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL", "OFF"] }
          },
          "required": ["json", "level"]
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "service": { "type": "object" },
        "probes": { "type": "object" },
        "resources": { "type": "object" }
      },
      "required": ["image", "replicas", "service", "probes", "resources"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "dev": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "quarkusLaunchDevmode": { "type": "string" },
        "javaToolOptions": { "type": "string" }
      },
      "required": ["enabled", "quarkusLaunchDevmode", "javaToolOptions"]
    },
    "resourceQuantity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]{1,2}|[PTGMK]i|[numkMGTPE])?$"
    },
    "resourcePair": {
      "type": "object",
      "properties": {
        "cpu": { "$ref": "#/definitions/resourceQuantity" },
        "memory": { "$ref": "#/definitions/resourceQuantity" }
      },
      "required": ["cpu", "memory"],
      "additionalProperties": false
    },
    "partialResourcePair": {
      "type": "object",
      "properties": {
        "cpu": { "$ref": "#/definitions/resourceQuantity" },
        "memory": { "$ref": "#/definitions/resourceQuantity" }
      },
      "additionalProperties": false
    }
  }
}

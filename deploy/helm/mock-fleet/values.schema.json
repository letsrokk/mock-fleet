{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mock-fleet values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespaceOverride": { "type": "string" },
    "fleet": {
      "type": "object",
      "properties": {
        "proxy": { "$ref": "#/definitions/app" },
        "api": {
          "allOf": [
            { "$ref": "#/definitions/app" },
            {
              "type": "object",
              "properties": {
                "podInactivityThreshold": { "type": "string" },
                "podCreationTimeout": { "type": "string" },
                "wiremock": { "type": "object" }
              },
              "required": ["podInactivityThreshold", "podCreationTimeout", "wiremock"]
            }
          ]
        },
        "dash": {
          "allOf": [
            { "$ref": "#/definitions/app" },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              },
              "required": ["enabled"]
            }
          ]
        }
      },
      "required": ["proxy", "api", "dash"]
    },
    "ingress": { "type": "object" },
    "storage": { "type": "object" },
    "securityContext": { "type": "object" },
    "env": { "type": "object" },
    "serviceAccount": { "type": "object" },
    "rbac": { "type": "object" },
    "hazelcast": { "type": "object" }
  },
  "required": ["fleet", "ingress", "storage", "securityContext", "env", "serviceAccount", "rbac", "hazelcast"],
  "definitions": {
    "app": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "dev": { "$ref": "#/definitions/dev" },
        "routing": { "type": "object" },
        "replicas": { "type": "integer", "minimum": 1 },
        "service": { "type": "object" },
        "probes": { "type": "object" },
        "resources": { "type": "object" }
      },
      "required": ["image", "replicas", "service", "probes", "resources"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "dev": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "quarkusLaunchDevmode": { "type": "string" },
        "javaToolOptions": { "type": "string" }
      },
      "required": ["enabled", "quarkusLaunchDevmode", "javaToolOptions"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "mock-fleet values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespaceOverride": { "type": "string" },
    "fleet": {
      "type": "object",
      "properties": {
        "proxy": { "$ref": "#/definitions/app" },
        "api": {
          "allOf": [
            { "$ref": "#/definitions/app" },
            {
              "type": "object",
              "properties": {
                "replicas": { "type": "integer", "minimum": 2 },
                "podInactivityThreshold": { "type": "string" },
                "podCreationTimeout": { "type": "string" },
                "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
                "updateStrategy": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
                    "rollingUpdate": {
                      "type": "object",
                      "properties": {
                        "maxUnavailable": { "type": ["integer", "string"] },
                        "maxSurge": { "type": ["integer", "string"] }
                      },
                      "required": ["maxUnavailable", "maxSurge"]
                    }
                  },
                  "required": ["type", "rollingUpdate"]
                },
                "pdb": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "minAvailable": { "type": ["integer", "string"] }
                  },
                  "required": ["enabled", "minAvailable"]
                }
              },
              "required": ["podInactivityThreshold", "podCreationTimeout", "terminationGracePeriodSeconds", "updateStrategy", "pdb"]
            }
          ]
        },
        "dash": {
          "allOf": [
            { "$ref": "#/definitions/app" },
            {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              },
              "required": ["enabled"]
            }
          ]
        }
      },
      "required": ["proxy", "api", "dash"]
    },
    "ingress": { "type": "object" },
    "storage": { "type": "object" },
    "wiremock": {
      "type": "object",
      "properties": {
        "podNamePrefix": { "type": "string", "minLength": 1 },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": { "type": "object" }
          },
          "required": ["create", "name", "annotations"]
        }
      },
      "required": ["serviceAccount"]
    },
    "securityContext": { "type": "object" },
    "env": { "type": "object" },
    "serviceAccount": { "type": "object" },
    "rbac": { "type": "object" },
    "hazelcast": {
      "type": "object",
      "properties": {
        "clusterName": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "backupCount": { "type": "integer", "minimum": 0, "maximum": 6 },
        "gracefulShutdownMaxWaitSeconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["clusterName", "port", "backupCount", "gracefulShutdownMaxWaitSeconds"]
    }
  },
  "required": ["fleet", "ingress", "storage", "wiremock", "securityContext", "env", "serviceAccount", "rbac", "hazelcast"],
  "definitions": {
    "app": {
      "type": "object",
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "dev": { "$ref": "#/definitions/dev" },
        "routing": { "type": "object" },
        "logging": {
          "type": "object",
          "properties": {
            "json": { "type": "boolean" },
            "level": { "type": "string", "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL", "OFF"] }
          },
          "required": ["json", "level"]
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "service": { "type": "object" },
        "probes": { "type": "object" },
        "resources": { "type": "object" }
      },
      "required": ["image", "replicas", "service", "probes", "resources"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "dev": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "quarkusLaunchDevmode": { "type": "string" },
        "javaToolOptions": { "type": "string" }
      },
      "required": ["enabled", "quarkusLaunchDevmode", "javaToolOptions"]
    }
  }
}
